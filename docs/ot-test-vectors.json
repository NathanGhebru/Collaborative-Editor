        "clientOperationId": "11111111-1111-1111-1111-111111111111",
        "baseRevision": 0,
        "operation": {
          "kind": "INSERT",
          "position": 2,
          "text": "123"
        }
      },
      "opB": {
        "clientId": "00000000-0000-0000-0000-000000000002",
        "clientOperationId": "22222222-2222-2222-2222-222222222222",
        "baseRevision": 0,
        "operation": {
          "kind": "INSERT",
          "position": 4,
          "text": "XYZ"
        }
      },
      "expectedTransformedA": {
        "kind": "INSERT",
        "position": 2,
        "text": "123"
      },
      "expectedTransformedB": {
        "kind": "INSERT",
        "position": 7,
        "text": "XYZ"
      },
      "expectedDocAfterAThenBPrime": "ab123cdXYZef",
      "expectedDocAfterBThenAPrime": "ab123cdXYZef",
      "expectedConvergedDocument": "ab123cdXYZef"
    },
