{
  "version": 1,
  "description": "Canonical Operational Transformation test vectors for Collaborative-Editor (OT-001 / OT-002)",
  "indexing": "UTF-16 code units (0-indexed)",
  "tieBreakerRule": "Lexicographical comparison of (clientId, clientOperationId) lowercase UUID strings. Lower key has precedence (placed first / stays left).",
  "insertWinsRule": "Concurrent insertions survive deletions. DELETE vs INSERT inside range splits into a sequential GROUP of DELETEs.",
  "vectors": [
